{
  "name": "raffaele-site-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint **/*.js",
    "lint:css": "stylelint **/*.css",
    "lint:html": "htmlhint **/*.html"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "htmlhint": "^1.1.4",
    "husky": "^8.0.0",
    "lint-staged": "^17.0.8",
    "stylelint": "^16.3.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "lint-staged": {
    "**/*.css": [
      "stylelint --fix"
    ],
    "**/*.{js,ts}": [
      "eslint --fix"
    ],
    "**/*.html": [
      "htmlhint"
    ]
  }
}
