{
  "name": "raffaele-site",
  "version": "1.0.0",
  "description": "Raffaele's personal website",
  "homepage": "https://gitlab.com/raffaele-suppa-group/raffaele-site#readme",
  "bugs": {
    "url": "https://gitlab.com/raffaele-suppa-group/raffaele-site/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/raffaele-suppa-group/raffaele-site.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "stylelint": "stylelint \"src/**/*/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "serve": "http-server public -p 8080 -s -c-1",
    "test:a11y:run": "pa11y-ci",
    "test:a11y": "start-server-and-test serve http://localhost:8080 test:a11y:run",
    "lint:html": "htmlhint \"public/*.html\" --config .htmlhintrc",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:js": "eslint .",
    "build:css": "lightningcss --minify --bundle --targets \">= 0.5%\" public/css/*.css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-xo": "^0.51.0",
    "globals": "^15.15.0",
    "htmlhint": "^1.1.4",
    "http-server": "^14.1.1",
    "lightningcss-cli": "^1.29.3",
    "pa11y-ci": "^4.1.1",
    "puppeteer": "^23.11.1",
    "start-server-and-test": "^2.0.3",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.8.3"
  }
}